{
  "name": "@thejaredwilcurt/csslop",
  "main": "index.js",
  "type": "module",
  "version": "0.0.32",
  "description": "Experimental CSS minification",
  "scripts": {
    "prestart": "node ./scripts/prestart.js",
    "start": "vite",
    "preview": "vite preview",
    "prebuild": "node ./scripts/prebuild.js",
    "build": "vite build",
    "postbuild": "node ./scripts/postbuild.js",
    "copy": "node ./scripts/copyTests.js",
    "test": "node ./tests/index.test.js",
    "real": "node ./tests/realworld.test.js",
    "lint": "eslint *.js scripts src tests --fix",
    "fix": "npm run lint",
    "bump": "npx --yes -- @jsdevtools/version-bump-prompt patch && npm i",
    "outdated": "npm outdated",
    "proto": "proto pin node latest --resolve --tool-native && proto pin npm latest --resolve --tool-native && git status"
  },
  "dependencies": {
    "@csstools/css-calc": "^3.3.0",
    "@node-projects/css-parser": "^5.2.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/view": "^6.43.9",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "codemirror": "^6.0.2",
    "eslint": "^10.9.1",
    "eslint-config-tjw-base": "^5.0.0",
    "eslint-config-tjw-import-x": "^1.0.1",
    "eslint-config-tjw-jsdoc": "^2.0.1",
    "eslint-plugin-import-x": "^4.17.0",
    "eslint-plugin-jsdoc": "^64.2.1",
    "fflate": "^0.8.3",
    "globals": "^17.11.0",
    "pretty-ms": "^9.3.1",
    "real-world-css-libraries": "^1.0.8",
    "vite": "^8.2.2"
  },
  "author": "The Jared Wilcurt",
  "homepage": "https://github.com/TheJaredWilcurt/csslop#readme",
  "bugs": {
    "url": "https://github.com/TheJaredWilcurt/csslop/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheJaredWilcurt/csslop.git"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.8.1"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.0.2"
    }
  }
}
